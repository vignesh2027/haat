# Copy to .env only if you want to change a default. `haat bootstrap` writes
# the account ids and keys it creates into .env by itself.

# NEAR JSON-RPC endpoint (testnet by default).
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Testnet account helper used to create the root account without a login.
NEAR_HELPER_URL=https://helper.nearprotocol.com
# Block explorer used for transaction links.
NEAR_EXPLORER_URL=https://testnet.nearblocks.io

# NEAR given to the market contract account (covers code storage) and to each shopkeeper.
HAAT_MARKET_FUNDING=4.5
HAAT_MERCHANT_FUNDING=0.5

# Written by bootstrap. Never commit real values.
# HAAT_ROOT=haat-xxxxxx.testnet
# HAAT_ROOT_KEYS=ed25519:...,ed25519:...
# HAAT_MARKET=market.haat-xxxxxx.testnet
# HAAT_MARKET_KEY=ed25519:...
# HAAT_KEY_RAMU=ed25519:...
# HAAT_KEY_MEENA=ed25519:...
# HAAT_KEY_BASHIR=ed25519:...
# HAAT_KEY_LAKSHMI=ed25519:...
# HAAT_WORLD_SEED=123
